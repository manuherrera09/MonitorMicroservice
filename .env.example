# Puerto del microservicio Monitor
PORT=8085

# URLs base de los microservicios a monitorear
VEHICULOS_SERVICE_URL=http://localhost:8083
CLIENTES_SERVICE_URL=http://localhost:8082
LEADS_SERVICE_URL=http://localhost:8000
CALIFICACION_SERVICE_URL=http://localhost:8084

# Configuración del planificador y umbrales
MONITOR_INTERVALO_MS=15000
MONITOR_TIMEOUT_MS=3000
MONITOR_UMBRAL_DEGRADADO_MS=1000

# Orígenes permitidos para CORS (Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
